{
  "name": "cybercore-charts",
  "version": "0.3.0",
  "type": "module",
  "description": "Zero-dependency cyberpunk SVG chart library with neon aesthetics and glitch effects",
  "main": "./dist/cybercore-charts.cjs",
  "module": "./dist/cybercore-charts.esm.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/cybercore-charts.umd.min.js",
  "jsdelivr": "./dist/cybercore-charts.umd.min.js",
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/cybercore-charts.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/cybercore-charts.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./ember": {
      "types": "./dist/ember/index.d.ts",
      "default": "./dist/ember/index.js"
    },
    "./umd": "./dist/cybercore-charts.umd.min.js",
    "./styles": "./src/styles/cyber-charts.scss",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css",
    "./dist/cybercore-charts.umd.js",
    "./dist/cybercore-charts.umd.min.js"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "dev:demo": "vite --config demo/vite.config.ts",
    "build": "npm run build:lib && npm run build:umd && npm run build:umd:min",
    "build:lib": "vite build && node scripts/build-types.ts",
    "build:umd": "vite build --mode umd",
    "build:umd:min": "vite build --mode umd-min",
    "build:demo": "vite build --config demo/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run check:size && npm run check:package && npm run build:demo",
    "check:size": "node scripts/check-size.ts",
    "check:package": "node scripts/check-package.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,scss,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,scss,json,md,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:visual": "scripts/visual.sh",
    "test:visual:update": "scripts/visual.sh --update-snapshots",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ember.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json && tsc -p demo/tsconfig.json && tsc -p demo/tsconfig.node.json",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist demo/dist coverage node_modules/.vite"
  },
  "keywords": [
    "charts",
    "svg",
    "cyberpunk",
    "data-visualization",
    "typescript",
    "zero-dependency",
    "neon",
    "glitch",
    "futuristic",
    "dark-theme",
    "bar-chart",
    "line-chart",
    "pie-chart",
    "radar-chart",
    "react",
    "react-charts",
    "react-components",
    "ember",
    "ember-charts",
    "ember-components",
    "glimmer",
    "octane"
  ],
  "author": "sebyx07",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebyx07/cybercore-charts.git"
  },
  "bugs": {
    "url": "https://github.com/sebyx07/cybercore-charts/issues"
  },
  "homepage": "https://sebyx07.github.io/cybercore-charts",
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "cybercore-css": "^0.4.0",
    "ember-modifier": "^4.3.0",
    "ember-source": "^7.4.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "rolldown": "^1.3.3",
    "rolldown-plugin-dts": "^0.30.2",
    "sass": "^1.108.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "^11.0.9"
    },
    "quick-temp": {
      "rimraf": "^6.1.4"
    }
  },
  "peerDependencies": {
    "ember-modifier": ">=4.0.0",
    "ember-source": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "ember-modifier": {
      "optional": true
    },
    "ember-source": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "allowScripts": {
    "esbuild": false,
    "@parcel/watcher": false
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.5.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
