{
  // Unit tests (Vitest) and Playwright specs, against the library sources.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
  // The Ember adapter and its tests need Ember's types: tsconfig.ember.json.
  "exclude": ["src/ember/**", "tests/ember/**"]
}
